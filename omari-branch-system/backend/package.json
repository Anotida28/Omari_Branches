{
  "name": "omari-branch-system-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "node scripts/prepare-prisma-client.js && ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "node scripts/prepare-prisma-client.js && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:bootstrap": "node scripts/prepare-prisma-client.js && prisma db push && node prisma/seed.js",
    "prisma:generate": "node scripts/prepare-prisma-client.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "morgan": "^1.11.0",
    "mssql": "^11.0.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "@types/mssql": "^9.1.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.30",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "prisma": "^6.19.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
