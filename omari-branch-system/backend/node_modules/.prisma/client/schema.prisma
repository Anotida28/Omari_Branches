generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id        BigInt   @id @default(autoincrement())
  username  String   @unique @db.VarChar(80)
  role      String   @default("VIEWER") @db.VarChar(20)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id        BigInt   @id @default(autoincrement())
  city      String   @db.VarChar(80)
  label     String   @db.VarChar(80)
  address   String?  @db.VarChar(255)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentLines BranchAgentLine[]
  metrics    BranchMetric[]
  expenses   Expense[]

  @@unique([city, label])
  @@index([city])
  @@index([label])
}

model BranchAgentLine {
  id         BigInt   @id @default(autoincrement())
  branchId   BigInt
  lineNumber String   @db.VarChar(60)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branch  Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  metrics AgentLineMetric[]

  @@unique([branchId, lineNumber], name: "uq_branch_line_number")
  @@index([lineNumber])
  @@index([branchId, isActive])
}

model ReminderRecipient {
  id        BigInt   @id @default(autoincrement())
  email     String   @unique(map: "uq_reminder_recipient_email") @db.VarChar(190)
  name      String?  @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([isActive])
}

model BranchMetric {
  id         BigInt   @id @default(autoincrement())
  branchId   BigInt
  metricDate DateTime @db.Date

  cashBalance             Decimal @default(0.00) @db.Decimal(18, 2)
  eFloatBalance           Decimal @default(0.00) @db.Decimal(18, 2)
  cashInVault             Decimal @default(0.00) @db.Decimal(18, 2)
  cashInVolume            Int     @default(0)
  cashInValue             Decimal @default(0.00) @db.Decimal(18, 2)
  cashOutVolume           Int     @default(0)
  cashOutValue            Decimal @default(0.00) @db.Decimal(18, 2)
  totalTransactionVolume  Int     @default(0)
  totalTransactionValue   Decimal @default(0.00) @db.Decimal(18, 2)
  commissionOnDeposits    Decimal @default(0.00) @db.Decimal(18, 2)
  commissionOnWithdrawals Decimal @default(0.00) @db.Decimal(18, 2)
  totalCommission         Decimal @default(0.00) @db.Decimal(18, 2)

  notes     String?  @db.VarChar(500)
  createdBy String?  @db.VarChar(120)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, metricDate], name: "uq_branch_date")
  @@index([metricDate])
  @@index([branchId, metricDate])
}

model AgentLineMetric {
  id          BigInt   @id @default(autoincrement())
  agentLineId BigInt
  metricDate  DateTime @db.Date

  cashBalance             Decimal @default(0.00) @db.Decimal(18, 2)
  eFloatBalance           Decimal @default(0.00) @db.Decimal(18, 2)
  cashInVault             Decimal @default(0.00) @db.Decimal(18, 2)
  cashInVolume            Int     @default(0)
  cashInValue             Decimal @default(0.00) @db.Decimal(18, 2)
  cashOutVolume           Int     @default(0)
  cashOutValue            Decimal @default(0.00) @db.Decimal(18, 2)
  totalTransactionVolume  Int     @default(0)
  totalTransactionValue   Decimal @default(0.00) @db.Decimal(18, 2)
  commissionOnDeposits    Decimal @default(0.00) @db.Decimal(18, 2)
  commissionOnWithdrawals Decimal @default(0.00) @db.Decimal(18, 2)
  totalCommission         Decimal @default(0.00) @db.Decimal(18, 2)

  notes     String?  @db.VarChar(500)
  createdBy String?  @db.VarChar(120)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentLine BranchAgentLine @relation(fields: [agentLineId], references: [id], onDelete: Cascade)

  @@unique([agentLineId, metricDate], name: "uq_agent_line_date")
  @@index([metricDate])
  @@index([agentLineId, metricDate])
}

model Expense {
  id       BigInt @id @default(autoincrement())
  branchId BigInt

  expenseType String   @db.VarChar(30)
  period      String   @db.Char(7) // YYYY-MM
  dueDate     DateTime @db.Date
  amount      Decimal  @db.Decimal(18, 2)
  currency    String   @default("USD") @db.Char(3)

  vendor String? @db.VarChar(120)
  notes  String? @db.VarChar(500)

  createdBy String?  @db.VarChar(120)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  alertLogs AlertLog[]

  @@unique([branchId, expenseType, period])
  @@index([branchId, period])
  @@index([dueDate])
  @@index([expenseType])
}

model AlertRule {
  id        BigInt     @id @default(autoincrement())
  ruleType  String     @db.VarChar(30)
  dayOffset Int
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  alertLogs AlertLog[]

  @@unique([ruleType, dayOffset], name: "uq_rule_type_offset")
}

model AlertLog {
  id               BigInt   @id @default(autoincrement())
  expenseId        BigInt
  ruleId           BigInt
  ruleType         String   @db.VarChar(30)
  dayOffset        Int
  triggerLocalDate DateTime @db.Date
  sentTo           String   @db.VarChar(190)
  sentAt           DateTime @default(now())
  status           String   @default("SENT") @db.VarChar(20)
  errorMessage     String?  @db.VarChar(500)

  expense Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  rule    AlertRule @relation(fields: [ruleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([expenseId])
  @@index([ruleId])
  @@index([expenseId, ruleId, triggerLocalDate, status], name: "idx_alert_dedupe_lookup")
  @@index([sentAt])
}

model JobLock {
  jobName     String   @id @db.VarChar(100)
  lockedUntil DateTime
  lockedBy    String   @db.VarChar(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
