# Database connection string (MySQL)
DATABASE_URL="mysql://root:your_password@localhost:3306/omari_branch_db"

# Token signing secret for auth (min 16 chars)
AUTH_TOKEN_SECRET="change-this-in-production-12345"

# Token lifetime in hours (optional, defaults to 24)
AUTH_TOKEN_TTL_HOURS=24

# Server port (optional, defaults to 4000)
PORT=4000

# Email delivery (Google Workspace / Gmail App Password)
EMAIL_PROVIDER=gmail
EMAIL_FROM="helpdesk@yourdomain.com"
EMAIL_USER="helpdesk@yourdomain.com"
# App password can include spaces or be stored as one continuous string.
EMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Shared authentication API (identity provider)
# Login flow is:
# 1) shared auth validates identity (BA_Users/AD in shared system)
# 2) local Prisma user role authorizes app access (VIEWER/FULL_ACCESS)
SHARED_AUTH_ENABLED=true
SHARED_AUTH_URL="http://180.10.1.222:3002/authenticate/login"
SHARED_AUTH_TIMEOUT_MS=8000
