# Database connection string (SQL Server)
DATABASE_URL="sqlserver://172.16.3.21:1433;database=Omari-branches ;user=Devuser;password=your_password;trustServerCertificate=true;encrypt=true"

# External identity check used by the app login endpoint.
AUTH_EXTERNAL_URL="http://180.10.1.222:3002/authenticate/login"
AUTH_EXTERNAL_TIMEOUT_MS=8000

# Access gateway verification for app authorization after external identity succeeds.
ACCESS_GATEWAY_ENABLED=true
ACCESS_GATEWAY_BASE_URL="http://172.16.3.21:3003"
ACCESS_GATEWAY_TIMEOUT_MS=8000

# JWT issued by this backend after successful external auth.
JWT_SECRET="change-this-jwt-secret-in-production"
JWT_EXPIRES_IN="8h"

# Comma-separated usernames that always become SUPER_ADMIN
SUPER_ADMIN_USERNAMES="om526127"

# Server port (optional, defaults to 4000)
PORT=4000

# Email delivery (Google Workspace / Gmail App Password)
EMAIL_PROVIDER=gmail
EMAIL_FROM="helpdesk@yourdomain.com"
EMAIL_USER="helpdesk@yourdomain.com"
# App password can include spaces or be stored as one continuous string.
EMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
# Login flow: external auth -> access gateway user check -> JWT issue.
