# Database connection string (SQL Server)
DATABASE_URL="sqlserver://172.16.3.21:1433;database=Omari-branches;user=Devuser;password=your_password;trustServerCertificate=true;encrypt=true"

# External identity check used by the app login endpoint.
AUTH_EXTERNAL_URL="http://180.10.1.222:3002/authenticate/login"
AUTH_EXTERNAL_TIMEOUT_MS=8000

# Access gateway verification for app authorization after external identity succeeds.
ACCESS_GATEWAY_ENABLED=true
ACCESS_GATEWAY_BASE_URL="http://172.16.3.21:3003"
ACCESS_GATEWAY_TIMEOUT_MS=8000

# JWT issued by this backend after successful external auth.
JWT_SECRET="change-this-jwt-secret-in-production"
JWT_EXPIRES_IN="8h"

# Comma-separated usernames that always become SUPER_ADMIN
SUPER_ADMIN_USERNAMES="om526127"

# Server port (optional, defaults to 4000)
PORT=4000

# Email delivery
# Default provider is the bulk mailer API.
EMAIL_PROVIDER=bulkmailer
BULK_MAILER_BASE_URL="https://bulkmailer-nlb-8d1146c95f851bda.elb.eu-west-1.amazonaws.com"
BULK_MAILER_SEND_PATH="/mail/send-email-single"
BULK_MAILER_FROM="omari@contactoldmutual.co.zw"
BULK_MAILER_AUTH_TOKEN=""
BULK_MAILER_TIMEOUT_MS=15000
BULK_MAILER_TRUST_SERVER_CERTIFICATE=true

# Optional Gmail fallback if EMAIL_PROVIDER=gmail
EMAIL_FROM="helpdesk@yourdomain.com"
EMAIL_USER="helpdesk@yourdomain.com"
# App password can include spaces or be stored as one continuous string.
EMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
# Login flow: external auth -> access gateway user check -> JWT issue.

# Source SQL Server used to import agent-line metrics into the app.
SOURCE_SQL_SERVER="172.16.7.216"
SOURCE_SQL_PORT=1433
SOURCE_SQL_DATABASE="omari_dp"
SOURCE_SQL_TLS_SERVER_NAME="OMSVR-OMARI-DB"
SOURCE_SQL_USER="Devwork"
SOURCE_SQL_PASSWORD="replace-me"
SOURCE_SQL_ENCRYPT=true
SOURCE_SQL_TRUST_SERVER_CERTIFICATE=true
SOURCE_SQL_CONNECT_TIMEOUT_MS=15000
SOURCE_SQL_REQUEST_TIMEOUT_MS=30000
# Canonical source view for per-agent daily totals.
SOURCE_SQL_AGENT_SUMMARY_TABLE="reporting.omari_agent_summary_since_launch_daily"
# Historical and current balance views used for e-float snapshots.
SOURCE_SQL_AGENT_BALANCE_TABLE="reporting.omari_account_balances_usd"
SOURCE_SQL_AGENT_BALANCE_CURRENT_TABLE="reporting.omari_account_balances_usd_current"
# BranchAgentLine.lineNumber should match this source column.
SOURCE_SQL_AGENT_LINE_MATCH_COLUMN="agent_account"

# Automatic source metric refresh.
SOURCE_SQL_SYNC_ENABLED=false
SOURCE_SQL_SYNC_CRON="15 7 * * *"
SOURCE_SQL_SYNC_LOOKBACK_DAYS=2
